{
  "rewrites": [
    { "source": "/auth/:path*", "destination": "https://nxt-crm-beta.vercel.app/auth/:path*" },
    { "source": "/dashboard/:path*", "destination": "https://nxt-crm-beta.vercel.app/dashboard/:path*" },
    { "source": "/onboarding", "destination": "https://nxt-crm-beta.vercel.app/onboarding" },
    { "source": "/invite/:path*", "destination": "https://nxt-crm-beta.vercel.app/invite/:path*" },
    { "source": "/api/:path*", "destination": "https://nxt-crm-beta.vercel.app/api/:path*" },
    { "source": "/_next/:path*", "destination": "https://nxt-crm-beta.vercel.app/_next/:path*" }
  ]
}
