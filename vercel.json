{
  "rewrites": [
    { "source": "/auth/:path*", "destination": "https://portal.nxtfinancialgroup.com/auth/:path*" },
    { "source": "/dashboard/:path*", "destination": "https://portal.nxtfinancialgroup.com/dashboard/:path*" },
    { "source": "/onboarding", "destination": "https://portal.nxtfinancialgroup.com/onboarding" },
    { "source": "/invite/:path*", "destination": "https://portal.nxtfinancialgroup.com/invite/:path*" },
    { "source": "/api/:path*", "destination": "https://portal.nxtfinancialgroup.com/api/:path*" },
    { "source": "/_next/:path*", "destination": "https://portal.nxtfinancialgroup.com/_next/:path*" }
  ]
}
